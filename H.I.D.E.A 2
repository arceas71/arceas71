<script>

/* =========================
   LOCATION
========================= */

function startGPS() {

    if (!navigator.geolocation) {
        showLocationError();
        return;
    }

    navigator.geolocation.watchPosition(

        function(position) {

            const c = position.coords;

            document.getElementById("latitude").textContent =
                c.latitude.toFixed(6) + "°";

            document.getElementById("longitude").textContent =
                c.longitude.toFixed(6) + "°";

            if (
                c.altitude !== null &&
                Number.isFinite(c.altitude)
            ) {

                document.getElementById("altitude").textContent =
                    c.altitude.toFixed(1) + " m";

            } else {

                document.getElementById("altitude").textContent =
                    "--";

            }

            document.getElementById("error").style.display =
                "none";

        },

        function() {
            showLocationError();
        },

        {
            enableHighAccuracy: true,
            maximumAge: 1000,
            timeout: 10000
        }

    );
}


function showLocationError() {

    document.getElementById("error").style.display =
        "flex";

}


/* =========================
   COMPASS
========================= */

function startCompass() {

    if (
        typeof DeviceOrientationEvent !== "undefined" &&
        typeof DeviceOrientationEvent.requestPermission === "function"
    ) {

        DeviceOrientationEvent.requestPermission()

        .then(function(permission) {

            if (permission === "granted") {

                window.addEventListener(
                    "deviceorientation",
                    handleCompass,
                    true
                );

            }

        })
        .catch(function() {});

    } else {

        window.addEventListener(
            "deviceorientationabsolute",
            handleCompass,
            true
        );

        window.addEventListener(
            "deviceorientation",
            handleCompass,
            true
        );

    }

}


function handleCompass(event) {

    let heading;

    if (event.webkitCompassHeading !== undefined) {

        heading = event.webkitCompassHeading;

    } else if (event.alpha !== null) {

        heading = 360 - event.alpha;

    } else {

        return;

    }

    heading = (heading + 360) % 360;

    /*
       The image itself starts rotated 180°.
       The compass heading is added to that base rotation.
    */

    const rotation = heading + 180;

    document.getElementById("person").style.transform =
        "translate(-50%, -50%) rotate(" +
        rotation +
        "deg)";

    document.getElementById("direction").textContent =
        heading.toFixed(0) + "° " +
        getDirection(heading);

}


function getDirection(degrees) {

    if (degrees >= 337.5 || degrees < 22.5)
        return "N";

    if (degrees < 67.5)
        return "NE";

    if (degrees < 112.5)
        return "E";

    if (degrees < 157.5)
        return "SE";

    if (degrees < 202.5)
        return "S";

    if (degrees < 247.5)
        return "SW";

    if (degrees < 292.5)
        return "W";

    return "NW";

}


/* =========================
   START
========================= */

startGPS();

document.addEventListener(
    "click",
    startCompass,
    { once: true }
);

document.addEventListener(
    "touchstart",
    startCompass,
    { once: true }
);

</script>

